# Telegram bot token from @BotFather
BOT_TOKEN=replace_me

# Three force-join destinations. Use @usernames or numeric chat IDs.
FORCE_JOIN_CHANNEL=@your_channel
FORCE_JOIN_GROUP_ONE=@your_first_group
FORCE_JOIN_GROUP_TWO=@your_second_group

# Optional public URLs shown on the buttons; defaults are derived from @usernames.
FORCE_JOIN_CHANNEL_URL=https://t.me/your_channel
FORCE_JOIN_GROUP_ONE_URL=https://t.me/your_first_group
FORCE_JOIN_GROUP_TWO_URL=https://t.me/your_second_group

# baron0 public free-check service
BARON_BASE_URL=https://baron0.com
BAN_CHECKER_API_URL=https://baron0.com/api/v2/check
BARON_API_KEY=
BARON_TIMEOUT_MS=20000
RICH_MESSAGES_ENABLED=true

# Branding
BOT_NAME=V-BAN-CHECKER
WATERMARK=Powered by Victory Tech™

# Optional owner/admin IDs for future admin-only features, comma separated.
OWNER_IDS=
